# Anthropic API キー（Claude で名刺OCRを行うために使用）
ANTHROPIC_API_KEY=

# GAS Web App の URL（index.html に埋め込まれているものと同じ）
GAS_URL=https://script.google.com/macros/s/AKfycbypcs3Kz4DYFcQtLwRxY4bSPM0ZO_6bjpNwCC1cEPWs8hNer1qWKtRVxTWB9j3aQOHz-g/exec

# GAS 側で要求するログインユーザー名・パスワード
APP_USER=
APP_PASS=

# ScanSnap の出力先（監視対象フォルダ）
WATCH_DIR=E:\namecardscan

# 名刺OCRに使用する Claude モデル
MODEL=claude-sonnet-4-6
