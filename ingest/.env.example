# Anthropic API キー（Claude で名刺OCRを行うために使用）
ANTHROPIC_API_KEY=

# GAS Web App の URL（index.html に埋め込まれているものと同じ）
GAS_URL=https://script.google.com/macros/s/AKfycbypcs3Kz4DYFcQtLwRxY4bSPM0ZO_6bjpNwCC1cEPWs8hNer1qWKtRVxTWB9j3aQOHz-g/exec

# 取込専用キー（GAS のスクリプトプロパティ INGEST_KEY と同じ値を入れる）
# 設定すると取込系 action（addCard / attachImages など）だけが通る。
# 推奨は 64 文字程度のランダム文字列（python -c "import secrets; print(secrets.token_hex(32))"）。
# GAS 側に INGEST_KEY を設定した後は、下の APP_USER / APP_PASS は空にしてよい。
INGEST_KEY=

# GAS 側のログインユーザー名・パスワード（移行期間用。INGEST_KEY 設定後は不要）
APP_USER=
APP_PASS=

# ScanSnap の出力先（監視対象フォルダ）
WATCH_DIR=E:\namecardscan

# 名刺OCRに使用する Claude モデル
MODEL=claude-sonnet-4-6
